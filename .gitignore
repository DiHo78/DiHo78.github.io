# The WordPress export (XML, or the zip WordPress.com sends) holds commenters'
# e-mail and IP addresses: it never enters the repo (ADR 0001).
*.xml
*.zip
!layouts/**/*.xml
# The public sitemap of the old blog holds only URLs and dates.
!/tools/sitemapcheck/wordpress-sitemap.xml

# Hugo's build output and caches
/public/
/resources/
/.hugo_build.lock
/assets/jsconfig.json

# Tool output
/node_modules/
/tmp/
